# Stock Trading Decision Support System - Environment Configuration
# Copy this file to .env and update with your actual values

# ========== Application Settings ==========
APP_NAME=stock-trading-decision-support
APP_ENV=development  # development, staging, production
DEBUG=True

# ========== Data Sources ==========
# Yahoo Finance (optional - yfinance works without API key)
YAHOO_FINANCE_API_KEY=

# Alternative data sources (for future use)
ALPHA_VANTAGE_API_KEY=
QUANDL_API_KEY=

# ========== File Paths ==========
# Data directories
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
DATA_FEATURES_PATH=./data/features
DATA_BACKTEST_PATH=./data/backtest

# Model directories
MODEL_SAVED_PATH=./models/saved_models
MODEL_SCALER_PATH=./models/scalers
MLFLOW_TRACKING_URI=./models/mlflow

# Log directories
LOG_PATH=./logs
LOG_APPLICATION_PATH=./logs/application
LOG_TRADING_PATH=./logs/trading
LOG_AUDIT_PATH=./logs/audit

# ========== Model Configuration ==========
# LSTM settings
LSTM_UNITS=128,64,32
LSTM_DROPOUT=0.2
LSTM_LEARNING_RATE=0.001
LSTM_EPOCHS=100
LSTM_BATCH_SIZE=32

# GRU settings
GRU_UNITS=128,64,32
GRU_DROPOUT=0.2
GRU_LEARNING_RATE=0.001
GRU_EPOCHS=100
GRU_BATCH_SIZE=32

# Ensemble settings
ENSEMBLE_WEIGHTS=0.50,0.50  # LSTM, GRU

# ========== Trading Configuration ==========
# Signal generation
BUY_THRESHOLD=0.02  # 2% expected gain
SELL_THRESHOLD=-0.01  # 1% expected loss
SIGNAL_CONFIDENCE_MIN=0.6

# Risk management
INITIAL_CAPITAL=100000
MAX_POSITION_SIZE=0.05  # 5% of portfolio per position
MIN_POSITION_SIZE=0.01  # 1% minimum
MAX_PORTFOLIO_RISK=0.20  # 20% maximum portfolio risk
MAX_DAILY_LOSS=0.05  # 5% maximum daily loss

# Stop loss and take profit
STOP_LOSS_PERCENT=0.02  # 2% stop loss
TAKE_PROFIT_PERCENT=0.05  # 5% take profit
USE_TRAILING_STOP=False
TRAILING_STOP_PERCENT=0.03

# Position sizing method
POSITION_SIZING_METHOD=kelly_criterion  # fixed_percentage, kelly_criterion, volatility_based

# ========== Backtesting Configuration ==========
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION=0.0  # Commission per trade (0 for zero commission)
BACKTEST_SLIPPAGE=0.001  # 0.1% slippage
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2024-01-01

# ========== Monitoring Configuration ==========
# Drift detection
DRIFT_DETECTION_WINDOW=30  # days
DRIFT_THRESHOLD=0.05
DRIFT_CHECK_FREQUENCY=daily

# Performance monitoring
PERFORMANCE_WINDOW=30  # days
PERFORMANCE_ALERT_THRESHOLD=-0.10  # Alert if performance drops 10%

# Model retraining
AUTO_RETRAIN=False
RETRAIN_FREQUENCY=monthly
RETRAIN_PERFORMANCE_THRESHOLD=0.15  # Retrain if performance drops 15%

# ========== API Configuration ==========
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True  # Set to False in production
API_WORKERS=4
API_TITLE=Stock Trading Decision Support API
API_VERSION=v1

# API Security (for future use)
API_KEY=
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate limiting (for future use)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=60

# ========== Dashboard Configuration ==========
DASHBOARD_PORT=8501
DASHBOARD_THEME=light  # light, dark
DASHBOARD_AUTO_REFRESH=True
DASHBOARD_REFRESH_INTERVAL=60  # seconds

# ========== Database Configuration (Future) ==========
DATABASE_TYPE=sqlite  # sqlite, postgresql, mysql
DATABASE_URL=sqlite:///./data/trading.db

# PostgreSQL (for future use)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=

# Redis (for future use)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== Logging Configuration ==========
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_ROTATION=daily  # daily, size
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_MB=100

# ========== MLflow Configuration ==========
MLFLOW_ENABLED=False
MLFLOW_EXPERIMENT_NAME=stock-trading
MLFLOW_TRACKING_SERVER=

# ========== Notification Configuration (Future) ==========
# Email
EMAIL_ENABLED=False
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Slack (for future use)
SLACK_ENABLED=False
SLACK_WEBHOOK_URL=

# Telegram (for future use)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========== Feature Flags ==========
FEATURE_SENTIMENT_ANALYSIS=False
FEATURE_NEWS_INTEGRATION=False
FEATURE_PORTFOLIO_OPTIMIZATION=False
FEATURE_MULTI_ASSET=False

# ========== Timezone ==========
TIMEZONE=UTC

# ========== Data Update Schedule ==========
DATA_UPDATE_ENABLED=True
DATA_UPDATE_TIME=09:00  # Time to update data (in TIMEZONE)
DATA_UPDATE_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA  # Comma-separated list

# ========== Testing Configuration ==========
TEST_MODE=False
TEST_DATA_PATH=./tests/test_data
MOCK_DATA_ENABLED=False

# ========== Performance Optimization ==========
USE_GPU=False
GPU_DEVICE_ID=0
NUM_WORKERS=4
CACHE_ENABLED=True
CACHE_TTL_SECONDS=300

# ========== Development Tools ==========
PROFILING_ENABLED=False
VERBOSE_LOGGING=False
SAVE_INTERMEDIATE_RESULTS=True
